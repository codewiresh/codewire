#!/bin/sh
# The image's Kimi Code lives outside the persistent home, and its own upgrade
# refuses that layout. Upgrading installs it into the home's npm prefix, which
# PATH prefers from then on. Everything else is Kimi Code itself.
set -eu
case "${1:-}:${2:-}" in
  upgrade: | update:) exec npm install --global @moonshot-ai/kimi-code@latest ;;
esac
exec /opt/codewire/agents/npm/lib/node_modules/@moonshot-ai/kimi-code/dist/main.mjs "$@"
