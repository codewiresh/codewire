# Strangler flip state — the local/CI rehearsal state for which units
# the Go fallback must cede while it still runs next to Rust.
# Consumed by the Gitea migration-integration gate and scripts/dev/dev-stack.sh.
#
# Flipping a unit = edit this file + the matching e2e coverage. The
# HTTP path flips live in the Caddyfiles + ingress manifests (see
# docs/dev/RUST-PORT-PLAYBOOK.md, "flip switches in lockstep").
#
# Go worker: consumers/loops it must NOT bind (owned by Rust/Temporal).
WORKER_SKIP_CONSUMERS=misc,env-setup,env-lifecycle,env-create
WORKER_SKIP_LOOPS=env-reconciler,sandbox-liveness,env-usage-metering,env-overage-billing,trials,temporal-worker,warm-pool-reconciler,billing-session
# Rust orchestration: D3 — the NATS consumer plane is RETIRED; all
# execution flows through the Temporal worker. (Port DNS lives on as
# PortDnsWorkflow; nothing published to jobs.misc in production.)
WORKER_CONSUMERS=
WORKER_LOOPS=env-reconciler,sandbox-liveness,warm-pool-reconciler,billing-session
# Rust billing service: billing crons it runs.
BILLING_LOOPS=env-usage-metering,env-overage-billing,trials
# D2 trigger flip: lifecycle triggers route through Temporal
# (SignalWithStart) on both sides — the Go API's emitter and the Rust
# reconciler. Requires TEMPORAL_HOST_PORT on both processes (infra
# config, set per deployment, not here).
ENVIRONMENT_ORCHESTRATOR=temporal-primary
