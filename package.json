{
  "name": "codewire",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Environment-first control plane for agent-oriented development",
  "workspaces": ["packages/*", "apps/*"],
  "overrides": {
    "js-yaml": "4.3.0"
  },
  "scripts": {
    "preflight": "./scripts/dev/preflight.sh",
    "hooks:install": "./scripts/dev/install-hooks.sh",
    "build": "make build",
    "dev": "make web",
    "typecheck": "bun run --cwd packages/codewire-proto-ts typecheck && bun run --cwd apps/dashboard typecheck",
    "up": "make up",
    "up:billing": "make up-billing",
    "down": "make down",
    "logs": "docker compose logs -f",
    "desktop": "cargo run --manifest-path crates/codewire-desktop/Cargo.toml",
    "desktop:build": "cargo build --manifest-path crates/codewire-desktop/Cargo.toml --release",
    "desktop:package:dry-run": "scripts/ci/release/package-codewire-desktop.sh --dry-run 0.0.0-ci",
    "rust:build": "cargo build",
    "rust:test": "cargo test",
    "rust:check": "cargo check",
    "validation:check-source": "python3 scripts/checks/repo_checks.py rust-validation-source",
    "retired:check-source": "python3 scripts/checks/repo_checks.py retired-reference-source",
    "go:check-source": "python3 scripts/checks/repo_checks.py go-source-classification",
    "docker:build": "docker build -t codewire-test .",
    "test": "make test-ui-kind",
    "test:billing": "env DATABASE_URL=postgres://codewire:codewire@localhost:54320/codewire?sslmode=disable ./apps/dashboard/node_modules/.bin/playwright test --config apps/dashboard/playwright.config.ts --project=dashboard-ssr-desktop --project=dashboard-ssr-mobile apps/dashboard/e2e/ssr-dashboard.billing-admin.ssr.ts",
    "test:billing:kind": "make test-ui-kind-billing",
    "test:lifecycle": "scripts/dev/kind/test-dashboard-kind.sh apps/dashboard/e2e/ssr-dashboard.environment-lifecycle.ssr.ts --project=dashboard-ssr-desktop",
    "kind:billing": "make kind-billing-listen",
    "stripe": "XDG_CONFIG_HOME=/tmp/stripe-config stripe listen --forward-to localhost:8080/api/webhooks/stripe"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.12.1",
    "typescript": "6.0.3"
  }
}
