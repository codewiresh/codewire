{
  "name": "codewire",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Environment-first control plane for agent-oriented development",
  "workspaces": ["packages/*", "apps/*"],
  "overrides": {
    "js-yaml": "4.3.0",
    "sharp": "0.35.0"
  },
  "scripts": {
    "preflight": "./scripts/dev/preflight.sh",
    "hooks:install": "./scripts/dev/install-hooks.sh",
    "build": "turbo build",
    "dev": "infisical run -- turbo dev",
    "dev:local": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "up": "infisical run --env=local --path=/local-kind -- make up",
    "up:billing": "infisical run --env=local --path=/ -- make up-billing",
    "down": "make down",
    "logs": "docker compose logs -f",
    "desktop": "cargo run --manifest-path crates/codewire-desktop/Cargo.toml",
    "desktop:build": "cargo build --manifest-path crates/codewire-desktop/Cargo.toml --release",
    "desktop:package:dry-run": "scripts/ci/release/package-codewire-desktop.sh --dry-run 0.0.0-ci",
    "rust:build": "cargo build",
    "rust:test": "cargo test",
    "rust:check": "cargo check",
    "validation:check-source": "python3 scripts/checks/repo_checks.py rust-validation-source",
    "retired:check-source": "python3 scripts/checks/repo_checks.py retired-reference-source",
    "go:check-source": "python3 scripts/checks/repo_checks.py go-source-classification",
    "docker:build": "docker build -t codewire-test .",
    "test": "infisical run --env=local -- env DATABASE_URL=postgres://codewire:codewire@localhost:54320/codewire?sslmode=disable ./apps/dashboard/node_modules/.bin/playwright test --config apps/dashboard/playwright.config.ts",
    "test:billing": "infisical run --env=local -- env DATABASE_URL=postgres://codewire:codewire@localhost:54320/codewire?sslmode=disable ./apps/dashboard/node_modules/.bin/playwright test --config apps/dashboard/playwright.config.ts --project=setup --project=billing",
    "test:billing:kind": "infisical run --env=local --path=/ -- make test-ui-kind-billing",
    "test:billing:smoke:kind": "infisical run --env=local --path=/ -- make test-billing-smoke-kind",
    "test:lifecycle": "infisical run --env=local -- env DATABASE_URL=postgres://codewire:codewire@localhost:54320/codewire?sslmode=disable ./apps/dashboard/node_modules/.bin/playwright test --config apps/dashboard/playwright.config.ts --project=setup --project=lifecycle",
    "kind:billing": "infisical run --env=local --path=/ -- make kind-billing-listen",
    "stripe": "XDG_CONFIG_HOME=/tmp/stripe-config stripe listen --forward-to localhost:8080/api/webhooks/stripe"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.12.1",
    "turbo": "2.9.16",
    "typescript": "6.0.3"
  }
}
