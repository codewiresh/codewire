# Non-secret local settings for the CI, Kind and smoke scripts. Copy to .envrc
# (untracked) and uncomment only what differs from the defaults; every value
# below is the default the scripts already use.
#
# Never put a secret here. Secrets and provider credentials come from OpenBao
# through the repository wrappers (scripts/runtime/dev/with-dev-smoke-auth.sh,
# make kind-credentials-real) and never touch a file.

# OpenBao that serves signing keys and publisher credentials.
# export CODEWIRE_OPENBAO_ADDR=https://openbao.example.invalid

# Origins `make kind-watch` and the Kind e2e profile use for the dashboard and API.
# export KIND_PUBLIC_ORIGIN=http://localhost:4174
# export KIND_BROWSER_API_ORIGIN=http://localhost:8090

# Image build caches. Every image builds the one runtime Cargo profile, which
# no setting selects.
# export CODEWIRE_SCCACHE_MODE=local
# export CODEWIRE_BUILDKIT_CACHE_MODE=local

# Site configuration. These have no default; a script that needs one stops
# and names it (docs/dev/CI-CONFIGURATION.md).
# Image registry host the image, Kind, Dev smoke and Production scripts use.
# export CODEWIRE_IMAGE_REGISTRY=registry.example.invalid
# S3 endpoint of the CI compiler and layer cache buckets.
# export CODEWIRE_R2_CACHE_ENDPOINT=https://r2-cache.example.invalid
# Disposable cache bucket a local r2-mode workspace build uses.
# export CODEWIRE_CI_SCCACHE_BUCKET_UNTRUSTED=example-ci-cache-untrusted
# Forgejo base URL for scripts that call its API outside CI.
# export GITHUB_SERVER_URL=https://git.example.invalid
# owner/name of the public repository on that Forgejo the local VM journeys
# clone at a pinned commit: a mirror of github.com/noeljackson/supplychain.
# export CODEWIRE_FORGEJO_FIXTURE_REPOSITORY=example/supplychain

# Hosted cluster bindings for the Dev and Production operator scripts. These
# have no default: the source tree carries no live cluster value (#1383).
# export CODEWIRE_DEV_CLUSTER=example-dev-cluster
# export CODEWIRE_PROD_CLUSTER=example-prod-cluster
# The Dev cluster route and trust pin the hosted checkout fixture requires,
# from Infra clusters/kubernetes-access.json.
# export CODEWIRE_DEV_KUBE_SERVER=https://192.0.2.30:6443
# export CODEWIRE_DEV_KUBE_TLS_SERVER_NAME=api.example-dev-cluster.example.invalid
# export CODEWIRE_DEV_KUBE_CA_SHA256=<SHA-256 of the cluster CA certificate>

# Per-worktree overrides stay out of the shared file.
[ -f "$(dirname "${BASH_SOURCE[0]:-$0}")/.envrc.local" ] && . "$(dirname "${BASH_SOURCE[0]:-$0}")/.envrc.local"

# Workstation-wide values live in ~/.config/codewire/env, sourced from the
# shell profile, so every worktree shares them. Copy this file's settings there.
# In CI the same names come from repository Actions variables.
