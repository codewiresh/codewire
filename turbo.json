{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "generate": {},
    "migrate": {
      "dependsOn": ["generate"]
    },
    "push": {},
    "rust:build": {
      "cache": false,
      "inputs": ["crates/**/*.rs", "crates/**/Cargo.toml"]
    },
    "rust:test": {
      "cache": false,
      "inputs": ["crates/**/*.rs", "crates/**/Cargo.toml"]
    },
    "rust:check": {
      "cache": false,
      "inputs": ["crates/**/*.rs", "crates/**/Cargo.toml"]
    },
    "wasm:build": {
      "inputs": ["crates/codewire-types/src/**", "crates/codewire-wasm/src/**", "crates/codewire-wasm/Cargo.toml"],
      "outputs": ["packages/codewire-wasm/pkg/**"]
    },
    "types:generate": {
      "inputs": ["openapi.json"],
      "outputs": ["packages/codewire-types/generated/**"]
    }
  }
}
