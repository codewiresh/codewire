{
  "components": {
    "schemas": {
      "AuthResponse": {
        "description": "Mirrors `auth.AuthResponse`. `skip_2fa_setup` is `omitempty` on the\nGo side and the idp service has no `Skip2FASetup` config, so it is\nalways `false` here and omitted from the body.",
        "properties": {
          "session": {
            "$ref": "#/components/schemas/SessionResponse"
          },
          "skip_2fa_setup": {
            "type": "boolean"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "user",
          "session"
        ],
        "title": "AuthResponse",
        "type": "object"
      },
      "EnableTwoFactorResult": {
        "properties": {
          "backupCodes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "secret": {
            "type": "string"
          },
          "totpUri": {
            "type": "string"
          }
        },
        "required": [
          "totpUri",
          "secret",
          "backupCodes"
        ],
        "title": "EnableResponse",
        "type": "object"
      },
      "ForgetPasswordInputBody": {
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ForgetPasswordRequest",
        "type": "object"
      },
      "ForgetPasswordOutputBody": {
        "properties": {
          "sent": {
            "type": "boolean"
          }
        },
        "required": [
          "sent"
        ],
        "title": "ForgetPasswordResponse",
        "type": "object"
      },
      "GetSessionResponse": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/AuthResponse"
          }
        ],
        "nullable": true,
        "title": "Nullable_AuthResponse"
      },
      "ResetPasswordInputBody": {
        "properties": {
          "newPassword": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "newPassword"
        ],
        "title": "ResetPasswordRequest",
        "type": "object"
      },
      "ResetPasswordOutputBody": {
        "properties": {
          "reset": {
            "type": "boolean"
          }
        },
        "required": [
          "reset"
        ],
        "title": "ResetPasswordResponse",
        "type": "object"
      },
      "SendVerificationOutputBody": {
        "properties": {
          "already_verified": {
            "type": "boolean"
          },
          "sent": {
            "type": "boolean"
          }
        },
        "title": "SendVerificationResponse",
        "type": "object"
      },
      "SessionResponse": {
        "description": "Mirrors `auth.SessionResponse`.",
        "properties": {
          "expires_at": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "token",
          "expires_at"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SignInRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignInRequest",
        "type": "object"
      },
      "SignInResponseBody": {
        "description": "Mirrors `SignInResponseBody` — `user`/`session` are `omitempty`\npointers, `twoFactorRequired`/`twoFactorToken` are `omitempty`. The\nsuccess branch sends `user`+`session`; the 2FA branch sends only\n`twoFactorRequired`+`twoFactorToken`.",
        "properties": {
          "session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionResponse"
              }
            ],
            "nullable": true
          },
          "twoFactorRequired": {
            "type": "boolean"
          },
          "twoFactorToken": {
            "type": "string"
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserResponse"
              }
            ],
            "nullable": true
          }
        },
        "title": "SignInResponseBody",
        "type": "object"
      },
      "SignOutOutputBody": {
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "title": "SignOutBody",
        "type": "object"
      },
      "SignUpRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "invite_code": {
            "default": "",
            "type": "string"
          },
          "name": {
            "default": "",
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignUpRequest",
        "type": "object"
      },
      "TwoFactorCodeInputBody": {
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "CodeRequest",
        "type": "object"
      },
      "TwoFactorDisableOutputBody": {
        "properties": {
          "disabled": {
            "type": "boolean"
          }
        },
        "required": [
          "disabled"
        ],
        "title": "DisableResponse",
        "type": "object"
      },
      "TwoFactorVerifyOutputBody": {
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "title": "VerifyResponse",
        "type": "object"
      },
      "UserResponse": {
        "description": "Mirrors `auth.UserResponse` field-for-field (JSON names + nullability).",
        "properties": {
          "created_at": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "image": {
            "nullable": true,
            "type": "string"
          },
          "is_admin": {
            "type": "boolean"
          },
          "name": {
            "nullable": true,
            "type": "string"
          },
          "two_factor_enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "email_verified",
          "name",
          "image",
          "is_admin",
          "two_factor_enabled",
          "created_at"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "ValidateTOTPInputBody": {
        "properties": {
          "code": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "token"
        ],
        "title": "ValidateRequest",
        "type": "object"
      },
      "VerifyEmailOutputBody": {
        "properties": {
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "verified"
        ],
        "title": "VerifyEmailResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Codewire API (Rust preview)",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/auth/forget-password": {
      "post": {
        "operationId": "forgetPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgetPasswordInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForgetPasswordOutputBody"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Request a password reset email",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/get-session": {
      "get": {
        "operationId": "getSession",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSessionResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get current session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "operationId": "resetPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetPasswordOutputBody"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Reset password with token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/send-verification-email": {
      "post": {
        "operationId": "sendVerificationEmail",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendVerificationOutputBody"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Send email verification link",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/sign-in": {
      "post": {
        "operationId": "signIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponseBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Sign in to an existing account",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "operationId": "signOut",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignOutOutputBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Sign out and invalidate session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/sign-up": {
      "post": {
        "operationId": "signUp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Create a new account",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/two-factor/disable": {
      "post": {
        "operationId": "disableTwoFactor",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TwoFactorDisableOutputBody"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Disable 2FA",
        "tags": [
          "two-factor"
        ]
      }
    },
    "/api/auth/two-factor/enable": {
      "post": {
        "operationId": "enableTwoFactor",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnableTwoFactorResult"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Start 2FA setup",
        "tags": [
          "two-factor"
        ]
      }
    },
    "/api/auth/two-factor/validate": {
      "post": {
        "operationId": "validateTOTP",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateTOTPInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Validate TOTP code during sign-in",
        "tags": [
          "two-factor"
        ]
      }
    },
    "/api/auth/two-factor/verify": {
      "post": {
        "operationId": "verifyTwoFactor",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TwoFactorCodeInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TwoFactorVerifyOutputBody"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Confirm 2FA setup with TOTP code",
        "tags": [
          "two-factor"
        ]
      }
    },
    "/api/auth/verify-email": {
      "get": {
        "operationId": "verifyEmail",
        "parameters": [
          {
            "in": "query",
            "name": "token",
            "required": true,
            "schema": {
              "description": "Verification token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyEmailOutputBody"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Verify email with token",
        "tags": [
          "auth"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  }
}
