{
  "name": "@codewire/api-client",
  "version": "0.1.0",
  "description": "Generated TypeScript client for the Codewire API (openapi.json is the source of truth)",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ../../openapi.json -o src/schema.gen.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.13.5"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
