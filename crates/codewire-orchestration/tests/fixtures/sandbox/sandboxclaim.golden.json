{
  "apiVersion": "extensions.agents.x-k8s.io/v1beta1",
  "kind": "SandboxClaim",
  "metadata": {
    "finalizers": [
      "codewire.sh/deletion-protection"
    ],
    "labels": {
      "codewire.sh/environment-id": "env-golden-fixture-1234",
      "codewire.sh/org-id": "org-golden-fixture",
      "codewire.sh/type": "sandbox"
    },
    "name": "sandbox-env-golden-fixture-1234",
    "namespace": "codewire-runtime"
  },
  "spec": {
    "env": [
      {
        "containerName": "workspace",
        "name": "CODEWIRE_ENV_ID",
        "value": "env-golden-fixture-1234"
      },
      {
        "containerName": "workspace",
        "name": "GIT_BRANCH",
        "value": "main"
      }
    ],
    "warmPoolRef": {
      "name": "shadow-pool-tmpl-golden"
    },
    "workspaceResources": [
      {
        "containerName": "workspace",
        "resources": {
          "limits": {
            "cpu": "2000m",
            "ephemeral-storage": "10Gi",
            "memory": "4096Mi"
          },
          "requests": {
            "cpu": "2000m",
            "ephemeral-storage": "10Gi",
            "memory": "4096Mi"
          }
        }
      }
    ]
  }
}
