    "podTemplate": {
      "metadata": {
        "annotations": {
          "codewire.sh/disk-gib": "10",
          "codewire.sh/workspace": "true",
          "io.katacontainers.config.hypervisor.cc_init_data": ""
        },
        "labels": {
          "codewire.sh/type": "workspace"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "enableServiceLinks": false,
        "initContainers": [
          {
            "command": [
              "sh",
              "-c",
              "data_image=\"${CODEWIRE_DOCKER_DATA_IMAGE:-/workspace/.codewire/docker-data.ext4}\"\ndata_size=\"${CODEWIRE_DOCKER_DATA_SIZE:-8G}\"\nmount_mode=\"${CODEWIRE_DOCKER_MOUNT_MODE:-loop}\"\nif [ \"$mount_mode\" = \"loop\" ]; then\n  codewire_dir=\"$(dirname \"$data_image\")\"\n  mkdir -p \"$codewire_dir\"\n  chown 1000:1000 \"$codewire_dir\"\n  # Owner-writable only: the workspace daemon refuses a group- or\n  # world-writable ancestor of its platform session store.\n  chmod 0755 \"$codewire_dir\"\n  if [ ! -s \"$data_image\" ]; then\n    # A fresh sparse image reads as zeros, so mke2fs skips zeroing its\n    # inode tables and journal: a few MiB of writes at any size.\n    if ! { truncate -s \"$data_size\" \"$data_image\" &&\n      mkfs.ext4 -q -F -E lazy_itable_init=1,lazy_journal_init=1 \"$data_image\"; }; then\n      rm -f \"$data_image\"\n      echo \"the Docker data image $data_image was not created; Docker does not start\" >&2\n    fi\n  fi\n  if [ -s \"$data_image\" ]; then\n    # A grown workspace disk renders a larger data size: extend the image to\n    # it, never shrinking it, and grow its filesystem offline to fill the\n    # image. Growth keeps every byte, and a failed grow still starts Docker\n    # at its previous size (#3554).\n    data_gib=\"${data_size%G}\"\n    case \"$data_gib\" in ''|*[!0-9]*) data_gib=0 ;; esac\n    if [ \"$(stat -c %s \"$data_image\")\" -lt \"$((data_gib * 1073741824))\" ]; then\n      truncate -s \"$data_size\" \"$data_image\" || true\n    fi\n    data_fs_bytes=\"$(dumpe2fs -h \"$data_image\" 2>/dev/null | awk -F: '$1 == \"Block count\" { count = $2 } $1 == \"Block size\" { size = $2 } END { printf \"%.0f\", count * size }')\"\n    if [ \"$(stat -c %s \"$data_image\")\" -gt \"${data_fs_bytes:-0}\" ]; then\n      # resize2fs grows an unmounted filesystem only after a forced check;\n      # e2fsck exits 1 when it corrected something.\n      fsck_status=0\n      e2fsck -fy \"$data_image\" >/dev/null || fsck_status=$?\n      if [ \"$fsck_status\" -gt 1 ] || ! resize2fs \"$data_image\"; then\n        echo \"the Docker data filesystem did not grow to $data_size; Docker keeps its previous size\" >&2\n      fi\n    fi\n  fi\nfi"
            ],
            "env": [
              {
                "name": "CODEWIRE_DOCKER_DATA_IMAGE",
                "value": "/workspace/.codewire/docker-data.ext4"
              },
              {
                "name": "CODEWIRE_DOCKER_DATA_SIZE",
                "value": "8G"
              },
              {
                "name": "CODEWIRE_DOCKER_MOUNT_MODE",
                "value": "loop"
              }
            ],
            "image": "registry.example.invalid/codewire/daemon@sha256:2222222222222222222222222222222222222222222222222222222222222222",
            "name": "codewire-docker-data-init",
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              },
              "requests": {
                "cpu": "25m",
                "memory": "32Mi"
              }
            },
            "securityContext": {
              "runAsGroup": 0,
              "runAsUser": 0
            },
            "volumeMounts": [
              {
                "mountPath": "/workspace",
                "name": "workspace"
              }
            ]
          }
        ],
        "containers": [
          {
            "command": [
              "sh",
              "-c",
              "daemon_pid=; workload_pid=; shutdown() { daemon_pid=\"${daemon_pid:-$!}\"; workload_pid=\"${workload_pid:-$!}\"; kill \"$workload_pid\" \"$daemon_pid\" 2>/dev/null || true; wait \"$workload_pid\" 2>/dev/null || true; wait \"$daemon_pid\" 2>/dev/null || true; }; trap 'shutdown; exit 0' TERM INT; user_shell=/bin/bash; [ -x /bin/bash ] || user_shell=/bin/sh; grep -q '^[^:]*:[^:]*:1000:' /etc/passwd || echo \"codewire:x:1000:1000:codewire:/home/codewire:${user_shell}\" >> /etc/passwd; grep -q '^[^:]*:[^:]*:1000:' /etc/group || echo 'codewire:x:1000:' >> /etc/group; while [ ! -x /codewire/bin/cw ]; do sleep 0.1; done; /codewire/bin/cw __hosted-daemon & daemon_pid=$!; (exec 'sleep' 'infinity') & workload_pid=$!; while kill -0 \"$workload_pid\" 2>/dev/null; do if ! kill -0 \"$daemon_pid\" 2>/dev/null; then wait \"$daemon_pid\" 2>/dev/null || true; sleep 1; daemon_pid=; /codewire/bin/cw __hosted-daemon & daemon_pid=$!; fi; sleep 1; done; wait \"$workload_pid\"; status=$?; kill \"$daemon_pid\" 2>/dev/null || true; wait \"$daemon_pid\" 2>/dev/null || true; exit \"$status\""
            ],
            "env": [
              {
                "name": "CODEWIRE_WORKSPACE_SHIM_ADDR",
                "value": "0.0.0.0:7777"
