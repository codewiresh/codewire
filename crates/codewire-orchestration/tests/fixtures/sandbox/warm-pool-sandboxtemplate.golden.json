                "value": "8G"
              },
              {
                "name": "CODEWIRE_DOCKER_MOUNT_MODE",
                "value": "loop"
              }
            ],
            "image": "docker.io/library/docker:29.7.1-dind@sha256:3333333333333333333333333333333333333333333333333333333333333333",
            "name": "dind",
            "resources": {
