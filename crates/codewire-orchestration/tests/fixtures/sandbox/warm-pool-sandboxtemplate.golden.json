                "name": "docker-sock"
              }
            ]
          },
          {
            "command": [
              "sh",
              "-ec",
              "data_image=\"${CODEWIRE_DOCKER_DATA_IMAGE:-/workspace/.codewire/docker-data.ext4}\"\ndata_root=\"${CODEWIRE_DOCKER_DATA_ROOT:-/var/lib/docker}\"\nmount_mode=\"${CODEWIRE_DOCKER_MOUNT_MODE:-loop}\"\nmkdir -p \"$data_root\"\nif [ \"$mount_mode\" = \"loop\" ]; then\n  if [ ! -s \"$data_image\" ]; then\n    echo \"the Docker data image $data_image is missing; the codewire-docker-data-init init container prepares it before Docker starts\" >&2\n    exit 1\n  fi\n  if ! awk -v target=\"$data_root\" '$2 == target && $3 == \"ext4\" { found = 1 } END { exit found ? 0 : 1 }' /proc/mounts; then\n    mount -o loop \"$data_image\" \"$data_root\"\n  fi\nelif [ \"$mount_mode\" != \"none\" ]; then\n  echo \"unsupported CODEWIRE_DOCKER_MOUNT_MODE=$mount_mode\" >&2\n  exit 1\nfi\nexec dockerd --host \"unix:///var/run/docker/docker.sock\" --group 1000 --data-root \"$data_root\" --storage-driver vfs"
            ],
            "env": [
              {
                "name": "DOCKER_TLS_CERTDIR",
                "value": ""
              },
              {
                "name": "CODEWIRE_DOCKER_DATA_IMAGE",
                "value": "/workspace/.codewire/docker-data.ext4"
              },
              {
                "name": "CODEWIRE_DOCKER_DATA_ROOT",
                "value": "/var/lib/docker"
              },
              {
