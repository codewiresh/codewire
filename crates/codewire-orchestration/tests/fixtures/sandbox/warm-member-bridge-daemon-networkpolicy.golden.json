{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "labels": {
      "app.kubernetes.io/component": "warm-member-bridge",
      "app.kubernetes.io/managed-by": "codewire",
      "app.kubernetes.io/name": "codewire-warm-member-bridge",
      "codewire.sh/environment-id": "be31063a-8ec8-46d5-aa17-75cda1729370"
    },
    "name": "cw-daemon-warm-be31063a-8ec8-46d5-aa17-75cda1729370",
    "namespace": "dev-sandboxes"
  },
  "spec": {
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "dev"
              }
            },
            "podSelector": {
              "matchLabels": {
                "app.kubernetes.io/component": "orchestration",
                "app.kubernetes.io/name": "codewire"
              }
            }
          }
        ],
        "ports": [
          {
            "port": 7777,
            "protocol": "TCP"
          },
          {
            "port": 2222,
            "protocol": "TCP"
          },
          {
            "endPort": 65535,
            "port": 1,
            "protocol": "TCP"
          }
        ]
      },
      {
        "from": [
          {
            "ipBlock": {
              "cidr": "0.0.0.0/0",
              "except": [
                "10.0.0.0/8",
                "100.64.0.0/10",
