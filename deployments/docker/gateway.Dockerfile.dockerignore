# BuildKit per-Dockerfile ignore for the sandbox gateway image.
# Keep the context narrow while allowing the curated gateway workspace, the
# root `cw daemon` builder, and generated protobuf inputs.
*
!Cargo.toml
!Cargo.lock
!deployments
!deployments/docker
!deployments/docker/gateway.Cargo.toml
!deployments/docker/gateway.Cargo.lock
!crates
!crates/**
crates/**/target
!proto
!proto/**
!libs
!libs/gateway-proto
!libs/gateway-proto/**
**/.tmp
