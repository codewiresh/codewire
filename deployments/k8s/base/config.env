PORT=8080
DERP_HOST=derp.codewire.sh
STUN_HOST=stun.codewire.sh
STUN_PORT=3478
PREVIEW_BASE_DOMAIN=cwpreview.sh
LIFECYCLE_ORCHESTRATOR=temporal-primary
ENVIRONMENT_ORCHESTRATOR=temporal-primary
TEMPORAL_HOST_PORT=temporal-frontend.temporal-system.svc.cluster.local:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=codewire-lifecycle
TEMPORAL_UI_URL=
ENVIRONMENT=production
# SES sender selection is public configuration. The matching AWS sender
# credential projection supplies CODEWIRE_SES_ENABLED separately to only the
# IDP and billing workloads; without that marker, the temporary shared Resend
# rollback credential remains the selected sender.
CODEWIRE_SES_FROM=hello@codewire.sh
CODEWIRE_SES_REGION=eu-west-1
TERRAFORM_DIR=/terraform
NAMESPACE_PREFIX=prod-tenant
BAO_ADDR=
OPENBAO_KUBERNETES_API_AUDIENCE=
TENANT_SECRET_BAO_AUTH_MOUNT=kubernetes-codewire
TENANT_SECRET_BAO_ROLE=
TENANT_SECRET_BAO_AUDIENCE=
TENANT_SECRET_BAO_TRANSIT_MOUNT=transit
TENANT_SECRET_BAO_TRANSIT_KEY=tenant-dek
TENANT_SECRET_BAO_EXPECTED_CLUSTER_ID=
SANDBOX_RUNTIME_PROFILE=commodity
CODEWIRE_UDP_RELAY_ADVERTISE_ADDRS=
CODEWIRE_UDP_RELAY_ALLOCATOR_URL=
CODEWIRE_UDP_RELAY_BIND_ADDRS=
CODEWIRE_RUNTIME_TRANSPORT_ZONES_JSON=
CODEWIRE_DIRECT_UDP_LB_ENABLED=false
CODEWIRE_DIRECT_UDP_LB_IP=
CODEWIRE_DIRECT_UDP_LB_PORT_START=32000
CODEWIRE_DIRECT_UDP_LB_PORT_END=60999
CODEWIRE_DIRECT_UDP_LB_CLASS=io.cilium/l2-announcer
CODEWIRE_DIRECT_UDP_LB_SHARING_KEY=codewire-direct-udp
CODEWIRE_DIRECT_UDP_TRANSPORT_ZONE=
SANDBOX_DOCKER_MODE=profile-default
SANDBOX_WORKSPACE_IDENTITY_MODE=binding
SANDBOX_WORKSPACE_STORAGE_CLASS=
SANDBOX_KATA_AGENT_POLICY_ENABLED=false
SANDBOX_KATA_COCO_INIT_DATA_ENABLED=false
SANDBOX_KATA_COCO_KBS_URL=
