PORT=8080
DERP_HOST=derp.codewire.sh
STUN_HOST=stun.codewire.sh
STUN_PORT=3478
PREVIEW_BASE_DOMAIN=cwpreview.sh
LIFECYCLE_ORCHESTRATOR=temporal-primary
ENVIRONMENT_ORCHESTRATOR=temporal-primary
TEMPORAL_HOST_PORT=temporal-frontend.temporal-system.svc.cluster.local:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=codewire-lifecycle
TEMPORAL_UI_URL=
ENVIRONMENT=production
# SES sender selection is public configuration. The matching AWS sender
# credential projection supplies CODEWIRE_SES_ENABLED separately to only the
# IDP and billing workloads; without that marker, the temporary shared Resend
# rollback credential remains the selected sender.
CODEWIRE_SES_FROM=hello@codewire.sh
CODEWIRE_SES_REGION=eu-west-1
TERRAFORM_DIR=/terraform
NAMESPACE_PREFIX=prod-tenant
BAO_ADDR=
OPENBAO_KUBERNETES_API_AUDIENCE=
TENANT_SECRET_BAO_AUTH_MOUNT=kubernetes-codewire
TENANT_SECRET_BAO_ROLE=
TENANT_SECRET_BAO_AUDIENCE=
TENANT_SECRET_BAO_TRANSIT_MOUNT=transit
TENANT_SECRET_BAO_TRANSIT_KEY=tenant-dek
TENANT_SECRET_BAO_EXPECTED_CLUSTER_ID=
SANDBOX_RUNTIME_PROFILE=commodity
CODEWIRE_UDP_RELAY_ADVERTISE_ADDRS=
CODEWIRE_UDP_RELAY_ALLOCATOR_URL=
CODEWIRE_UDP_RELAY_BIND_ADDRS=
CODEWIRE_RUNTIME_TRANSPORT_ZONES_JSON=
CODEWIRE_DIRECT_UDP_LB_ENABLED=false
CODEWIRE_DIRECT_UDP_LB_IP=
CODEWIRE_DIRECT_UDP_LB_PORT_START=32000
CODEWIRE_DIRECT_UDP_LB_PORT_END=60999
CODEWIRE_DIRECT_UDP_LB_CLASS=io.cilium/l2-announcer
CODEWIRE_DIRECT_UDP_LB_SHARING_KEY=codewire-direct-udp
CODEWIRE_DIRECT_UDP_TRANSPORT_ZONE=
SANDBOX_DOCKER_MODE=profile-default
# Shared warm pools (Program #2238 C4): comma-separated exact shapes,
# <cpu>m/<memory>Mi/<disk>Gi=<members>. Empty keeps the reconciler and create
# routing inert; each overlay that runs pools sets its own shapes.
SANDBOX_WARM_POOL_SHAPES=
# StorageClass for commodity workspace volumes. Required, with no default:
# orchestration refuses to start while it is empty, unless the runtime profile
# is confidential (docs/CONFIGURATION.md). Each overlay sets its own.
SANDBOX_WORKSPACE_STORAGE_CLASS=
# VolumeSnapshotClass of hosted disk snapshots. Empty refuses them; each overlay
# that offers them sets its own.
SANDBOX_VOLUME_SNAPSHOT_CLASS=
# Commodity Block workspace layout: empty mounts the whole volume at both the
# home and /workspace; subfolder mounts only its workspace/ folder at
# /workspace (docs/CONFIGURATION.md).
SANDBOX_WORKSPACE_LAYOUT=
SANDBOX_KATA_AGENT_POLICY_ENABLED=false
SANDBOX_KATA_COCO_INIT_DATA_ENABLED=false
SANDBOX_KATA_COCO_KBS_URL=
SANDBOX_KATA_COCO_IMAGE_REGISTRY_AUTH_URI=
SANDBOX_KATA_COCO_TEST_RESOURCE_URI=
SANDBOX_KATA_COCO_TEST_RESOURCE_PATH=
# Each overlay names the repository its workspace image is pulled from;
# orchestration refuses to start without one (docs/CONFIGURATION.md).
CODEWIRE_WORKSPACE_IMAGE_REPOSITORY=
BILLING_CONTROLLER_ENABLED=true
BILLING_CONTROLLER_NAMESPACE=
BILLING_CONTROLLER_REQUEUE_SECONDS=60
BILLING_SESSION_LEDGER_CANONICAL=true
SANDBOX_CONFIDENTIAL_STORAGE_ENABLED=false
CONFIDENTIAL_STORAGE_BAO_ADDR=
CONFIDENTIAL_STORAGE_BAO_AUTH_MOUNT=kubernetes-codewire
CONFIDENTIAL_STORAGE_BAO_ROLE=
CONFIDENTIAL_STORAGE_BAO_AUDIENCE=
CONFIDENTIAL_STORAGE_BAO_KV_MOUNT=
CONFIDENTIAL_STORAGE_BAO_EXPECTED_CLUSTER_ID=
CONFIDENTIAL_STORAGE_KBS_URL=
CONFIDENTIAL_STORAGE_KBS_CA_PATH=
CONFIDENTIAL_STORAGE_KBS_ADMIN_TOKEN_FILE=/var/run/secrets/codewire-confidential-storage/kbs-admin-token
