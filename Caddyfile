# Local development Caddyfile
# Usage: sudo caddy run --config Caddyfile
#
# Access the app at: https://codewire.localhost
#
# Caddy automatically generates and trusts local certificates for .localhost domains
# No /etc/hosts changes needed - .localhost resolves to 127.0.0.1 automatically (RFC 6761)
{
	admin localhost:2020
	auto_https disable_redirects
	# Audit-IP integrity (#2505 M1): Caddy 2.10's default proxy posture is
	# REPLACE — an incoming client X-Forwarded-For is discarded and the peer
	# IP is forwarded as the sole hop. That is deliberate: adding
	# `trusted_proxies` here (e.g. 0.0.0.0/0 or private_ranges) switches the
	# edge to APPEND mode and preserves attacker-chosen hops for every
	# backend, re-opening the audit_logs IP spoof the IdP now defends
	# against (it reads the LAST parseable hop). Do not add trusted_proxies
	# unless another L7 proxy is placed in front of this Caddy — and then
	# list only that proxy's address range.
}

# App preview hosts route by Host header, not API path.
*.codewire.localhost {
	reverse_proxy localhost:8084
}

# Main web app
codewire.localhost {
	# OIDC provider (codewire-idp binary)
	@idp path /.well-known/openid-configuration /.well-known/oauth-authorization-server /.well-known/jwks.json /api/oauth/* /api/oidc/* /api/auth/two-factor/* /api/auth/verify-email /api/auth/forget-password /api/auth/reset-password /api/auth/send-verification-email /api/auth/sign-up /api/auth/sign-in /api/auth/sign-out /api/auth/get-session /api/auth/sessions /api/auth/sessions/revoke
	handle @idp {
		reverse_proxy localhost:8091
	}

	# Stripe delivery is the only permanent non-Connect billing route.
	@billing path /api/webhooks/stripe
	handle @billing {
		reverse_proxy localhost:8081
	}

	# Connect-RPC routes: /{package}.{Service}/{Method}
	# (connect-rpc/03, D5). Routing is per-Service because
	# packages span binaries. Billing-owned Services are matched before the
	# orchestration fallback.
	handle /codewire.internal.v1.MeshCoordinatorService/* {
		reverse_proxy localhost:18090 {
			transport http {
				versions h2c 2
			}
		}
	}
	@connect_mesh path /codewire.v1.MeshNetworkService/* /codewire.v1.MeshNodeService/* /codewire.v1.MeshInviteService/* /codewire.v1.MeshGroupService/* /codewire.v1.MeshKeyValueService/*
	handle @connect_mesh {
		reverse_proxy localhost:18090
	}
	@connect_admin path /codewire.admin.v1.AdminService/*
	handle @connect_admin {
		reverse_proxy localhost:8084
	}
	@connect_billing_catalog path /codewire.admin.v1.BillingCatalogService/*
	handle @connect_billing_catalog {
		reverse_proxy localhost:8081
	}
	@connect_billing path /codewire.console.v1.BillingService/*
	handle @connect_billing {
		reverse_proxy localhost:8081
	}
	# The coordinator's native bidi stream needs HTTP/2 on the backend leg.
	handle /codewire.internal.v1.CoordinatorService/* {
		reverse_proxy localhost:8090 {
			transport http {
				versions h2c 2
			}
		}
	}
	# Environment sessions are the second first-party bidi service whose
	# secure client leg uses native gRPC. Preserve h2c to orchestration.
	handle /codewire.v1.EnvironmentSessionService/* {
		reverse_proxy localhost:8084 {
			transport http {
				versions h2c 2
			}
		}
	}

	# Everything else lands on orchestration (the Connect twin of the
	# /api/* fallback below), so an unmatched RPC path
	# gets a Connect-shaped answer from a service, never dashboard HTML.
	# These matchers are drift-checked against proto/ by
	# scripts/checks/repo_checks.py connect-edge-routing.
	# OAuth enrollment and lifecycle mutations have their own authority.
	# Owner delegation is the isolated authority's native bidirectional stream.
	handle /codewire.v1.CredentialDelegationService/* {
		reverse_proxy localhost:8086 {
			flush_interval -1
			transport http {
				versions h2c 2
			}
		}
	}
	handle /codewire.v1.CredentialMutationService/* {
		reverse_proxy localhost:8086 {
			flush_interval -1
		}
	}
	handle /codewire.v1.GithubRepositoryService/* {
		reverse_proxy localhost:8086
	}
	handle /codewire.* {
		reverse_proxy localhost:8084
	}

	# Browser GitHub App authorization returns to the dashboard, not the API.
	handle /api/v1/github/oauth/callback {
		reverse_proxy localhost:5173
	}

	# All remaining API traffic is Rust orchestration. IdP, coordinator,
	# billing, and the browser GitHub callback have narrower matchers above.
	handle /api/* {
		reverse_proxy localhost:8084
	}

	# Default: Rust web app and generated documentation.
	reverse_proxy localhost:5173
}
