{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codewire.ci-baseline/v1",
  "title": "Codewire CI baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "target_base_commit", "baseline_commit", "head_commit", "head_tree", "provenance", "validation"],
  "properties": {
    "schema": {"const": "codewire.ci-baseline/v1"},
    "mode": {"enum": ["pull_request_merge_base", "push_before", "deployed_source", "published_support_pair"]},
    "target_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provenance": {"type": "object"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "reasons"],
      "properties": {
        "valid": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
