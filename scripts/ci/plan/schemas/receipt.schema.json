{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codewire.ci-verification-receipt/v1",
  "title": "Codewire exact-head verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "event", "pull_request", "workflow_path", "run", "source", "plan", "selection", "results"],
  "properties": {
    "schema": {"const": "codewire.ci-verification-receipt/v1"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "event": {"const": "pull_request"},
    "pull_request": {"type": "integer", "minimum": 1},
    "workflow_path": {"type": "string"},
    "run": {"type": "object"},
    "source": {"type": "object"},
    "plan": {"type": "object"},
    "selection": {"type": "string"},
    "results": {"type": "object"}
  }
}
