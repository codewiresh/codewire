{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codewire.ci-plan/v1",
  "title": "Codewire CI impact plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trusted_policy", "baseline", "verification", "artifacts", "degraded_reasons"],
  "properties": {
    "schema": {"const": "codewire.ci-plan/v1"},
    "trusted_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "policy_sha256", "graph_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "baseline": {"type": "object"},
    "verification": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "baseline_fingerprint", "head_fingerprint", "explanations"],
        "properties": {
          "state": {"enum": ["affected", "unaffected", "unclassified"]},
          "baseline_fingerprint": {"type": ["string", "null"]},
          "head_fingerprint": {"type": ["string", "null"]},
          "explanations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "degraded_reasons": {"type": "array", "items": {"type": "string"}}
  }
}
