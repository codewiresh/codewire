{
  "schema": "codewire.ci-artifact-graph/v1",
  "policy_files": [
    ".gitea/workflows/deploy-dev.yaml",
    ".gitea/workflows/support-images.yaml",
    "scripts/ci/deploy/resolve-deployed-source.sh",
    "scripts/ci/images/resolve-published-support-pair.sh",
    "scripts/ci/plan/apply-deploy-plan.py",
    "scripts/ci/plan/apply-support-plan.py",
    "scripts/ci/plan/apply-verification-plan.py",
    "scripts/ci/plan/artifact-graph.json",
    "scripts/ci/receipts/emit-verification-receipt.py",
    "scripts/ci/plan/planner.py",
    "scripts/ci/receipts/verify-release-tag-receipt.sh",
    "scripts/ci/select/require-verification-results.sh",
    "scripts/ci/select/select-verification.sh",
    "scripts/ci/receipts/verify-tested-tree-receipt.sh"
  ],
  "non_artifact_inputs": [
    ".agents/**",
    ".gitea/workflows/mirror-github.yaml",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/**",
    "scripts/ci/images/cosign-private-signing-config.json",
    "scripts/ci/images/sign-runtime-image-set.sh",
    "scripts/ci/tests/test-sign-runtime-image-set.sh",
    "scripts/ci/trust/codewire-runtime-signing.pub"
  ],
  "artifacts": {
    "dev_release_tree": {
      "kind": "file-set",
      "inputs": [
        "deployments/k8s/**"
      ]
    },
    "cw_cli_release_assets": {
      "kind": "rust-package",
      "manifest": "Cargo.toml",
      "package": "codewire-cli-bin",
      "lockfile": "Cargo.lock",
      "profiles": ["release", "ci"],
      "release_targets": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin"
      ],
      "package_inputs": {
        "codewire-proto": ["crates/codewire-proto/codewire_descriptor.bin"],
        "codewire-gateway-proto": ["libs/gateway-proto/proto/**"]
      },
      "explicit_inputs": [
        "rust-toolchain.toml",
        "scripts/ci/release/package-cw-release.sh",
        "scripts/ci/release/check-cw-darwin-sdkless.sh"
      ]
    },
    "desktop_package": {
      "kind": "rust-package",
      "manifest": "crates/codewire-desktop/Cargo.toml",
      "package": "codewire-desktop",
      "lockfile": "crates/codewire-desktop/Cargo.lock",
      "profiles": ["release"],
      "release_targets": ["host"],
      "package_inputs": {
        "codewire-proto": ["crates/codewire-proto/codewire_descriptor.bin"]
      },
      "explicit_inputs": [
        "rust-toolchain.toml",
        "scripts/ci/release/package-codewire-desktop.sh",
        "crates/codewire-desktop/LICENSE",
        "crates/codewire-desktop/resources/**"
      ]
    },
    "workspace_cw_binary": {
      "kind": "rust-package",
      "manifest": "Cargo.toml",
      "package": "codewire-cli-bin",
      "lockfile": "Cargo.lock",
      "profiles": ["release"],
      "release_targets": ["host"],
      "package_inputs": {
        "codewire-proto": ["crates/codewire-proto/codewire_descriptor.bin"],
        "codewire-gateway-proto": ["libs/gateway-proto/proto/**"]
      },
      "explicit_inputs": ["rust-toolchain.toml"]
    },
    "dashboard_image": {
      "kind": "file-set",
      "inputs": [
        ".dockerignore",
        "Cargo.toml",
        "Cargo.lock",
        "LICENSE",
        "apps/cli/install.sh",
        "apps/dashboard/Dockerfile",
        "apps/dashboard/runtime-inventory.json",
        "apps/docs/zola/**",
        "crates/**",
        "deployments/docker/rust-base.Dockerfile",
        "docker-bake.hcl",
        "libs/gateway-proto/**",
        "packages/codewire-design/**",
        "proto/**"
      ]
    },
    "gateway_image": {
      "kind": "file-set",
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**",
        "deployments/docker/gateway.Cargo.lock",
        "deployments/docker/gateway.Cargo.toml",
        "deployments/docker/gateway.Dockerfile",
        "deployments/docker/gateway.Dockerfile.dockerignore",
        "deployments/docker/rust-base.Dockerfile",
        "docker-bake.hcl",
        "libs/gateway-proto/**",
        "proto/**"
      ]
    },
    "derp_image": {
      "kind": "file-set",
      "inputs": [
        "crates/codewire-derp/**",
        "crates/codewire-proto/**",
        "crates/codewire-tailnet/**",
        "deployments/docker/derp.Cargo.lock",
        "deployments/docker/derp.Cargo.toml",
        "deployments/docker/derp.Dockerfile",
        "deployments/docker/derp.Dockerfile.dockerignore",
        "deployments/docker/rust-base.Dockerfile",
        "docker-bake.hcl",
        "proto/**"
      ]
    },
    "services_image": {
      "kind": "file-set",
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**",
        "deployments/docker/services.Dockerfile",
        "deployments/docker/services.Dockerfile.dockerignore",
        "deployments/docker/rust-base.Dockerfile",
        "docker-bake.hcl",
        "libs/gateway-proto/**",
        "proto/**"
      ]
    },
    "mesh_image": {
      "kind": "file-set",
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**",
        "deployments/docker/mesh.Dockerfile",
        "deployments/docker/mesh.Dockerfile.dockerignore",
        "deployments/docker/rust-base.Dockerfile",
        "docker-bake.hcl",
        "proto/**"
      ]
    },
    "base_image": {
      "kind": "file-set",
      "inputs": ["images/base/**"]
    },
    "confidential_probe_image": {
      "kind": "file-set",
      "inputs": ["images/confidential-probe/**"]
    },
    "workspace_image": {
      "kind": "composite",
      "dependencies": ["base_image", "workspace_cw_binary"],
      "inputs": ["images/workspace/**"]
    }
  }
}
