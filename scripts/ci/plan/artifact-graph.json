{
  "schema": "codewire.ci-artifact-graph/v1",
  "policy_files": [
    "scripts/ci/plan/artifact-graph.json",
    "scripts/ci/plan/planner.py",
    "scripts/ci/plan/schemas/baseline.schema.json",
    "scripts/ci/plan/schemas/plan.schema.json"
  ],
  "artifacts": {
    "cw_cli_release_assets": {
      "kind": "rust-package",
      "manifest": "Cargo.toml",
      "package": "codewire-cli-bin",
      "lockfile": "Cargo.lock",
      "profiles": ["release", "ci"],
      "release_targets": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin"
      ],
      "package_inputs": {
        "codewire-proto": ["crates/codewire-proto/codewire_descriptor.bin"],
        "codewire-gateway-proto": ["libs/gateway-proto/proto/**"]
      },
      "explicit_inputs": [
        "rust-toolchain.toml",
        "scripts/ci/release/package-cw-release.sh",
        "scripts/ci/release/check-cw-darwin-sdkless.sh"
      ]
    },
    "desktop_package": {
      "kind": "rust-package",
      "manifest": "crates/codewire-desktop/Cargo.toml",
      "package": "codewire-desktop",
      "lockfile": "crates/codewire-desktop/Cargo.lock",
      "profiles": ["release"],
      "release_targets": ["host"],
      "package_inputs": {
        "codewire-proto": ["crates/codewire-proto/codewire_descriptor.bin"]
      },
      "explicit_inputs": [
        "rust-toolchain.toml",
        "scripts/ci/release/package-codewire-desktop.sh",
        "crates/codewire-desktop/LICENSE",
        "crates/codewire-desktop/resources/**"
      ]
    },
    "dashboard_image": {"kind": "unmigrated"},
    "gateway_image": {"kind": "unmigrated"},
    "derp_image": {"kind": "unmigrated"},
    "services_image": {"kind": "unmigrated"},
    "mesh_image": {"kind": "unmigrated"},
    "base_image": {"kind": "unmigrated"},
    "workspace_image": {"kind": "unmigrated"}
  }
}
