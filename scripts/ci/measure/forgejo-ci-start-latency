#!/usr/bin/env python3
"""Read-only main-push job start latency from Forgejo's retained records.

`collect` reads one repository's main push runs over a bounded window and
prints one structural JSONL row per Heavy, protected, sized or Lite job:
eligible, assigned, first-command and stop times, the runner task identity and,
when a placement file is joined, the worker slot, pool and node. `placements`
reduces trusted Loki query_range responses to that placement file, and
`summary` reduces rows to per-class percentiles. Requests are GET-only against
fixed allowlisted Forgejo paths. No token, response body or log line is ever
printed; every failure is a fixed message.
"""

# Keep repository/peer lookup at the public entrypoint, also when a caller
# imports the resolved implementation path. Synthetic script copies stay local.
from pathlib import Path as _EntrypointPath
_entrypoint = _EntrypointPath(__file__).absolute()
if (_entrypoint.parent.name in {"commands", "checks", "tests"}
        and len(_entrypoint.parents) > 3 and _entrypoint.parents[2].name == "tools"):
    __file__ = str(_entrypoint.parents[3] / "scripts" / _entrypoint.name)

import argparse
import importlib.util
import json
import math
import os
import re
import ssl
import stat
import sys
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any, Callable

ROOT = Path(__file__).absolute().parent.parent
SERVER_URL_RE = re.compile(r"^https://[A-Za-z0-9.-]+(?::[0-9]+)?/?$")
REPOSITORIES = ("codewire/codewire",)
MAX_WINDOW = timedelta(days=31)
RUN_PAGE_LIMIT = 50
MAX_RUN_PAGES = 200
JOB_PAGE_LIMIT = 100
MAX_JSON_BYTES = 8 * 1024 * 1024
MAX_TEXT_BYTES = 1024 * 1024
MAX_STEPS = 200
TOKEN_RE = re.compile(r"^[A-Za-z0-9_-]{20,255}$")
REPO = r"(?:codewire/codewire)"
PATHS = {
    "runs": re.compile(
        rf"^/repos/{REPO}/actions/runs\?event=push&ref=refs%2Fheads%2Fmain"
        rf"&page=[1-9][0-9]{{0,2}}&limit={RUN_PAGE_LIMIT}$"),
    "jobs": re.compile(
        rf"^/repos/{REPO}/actions/runs/[1-9][0-9]{{0,11}}/jobs\?page=1&limit={JOB_PAGE_LIMIT}$"),
    "job": re.compile(rf"^/repos/{REPO}/actions/jobs/[1-9][0-9]{{0,11}}$"),
    "header": re.compile(
        rf"^/repos/{REPO}/actions/jobs/[1-9][0-9]{{0,11}}/logs\?attempt=[1-9][0-9]{{0,2}}"
        r"&step=0&q=received%20task&format=ndjson$"),
    "workflow": re.compile(
        rf"^/repos/{REPO}/raw/\.(?:forgejo|gitea)/workflows/[A-Za-z0-9_.-]{{1,100}}\.ya?ml"
        r"\?ref=[0-9a-f]{40}$"),
}
# The runner's own first line, e.g. "Runner <uuid> (version:v12.13.1)
# received task 47387 of job cw-release-assets, triggered by event: push".
HEADER_RE = re.compile(
    r"^Runner ([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}) "
    r"\(version:(v[0-9][0-9A-Za-z.+-]{0,40})\) received task ([1-9][0-9]{0,15}) "
    r"of job ([A-Za-z0-9_-]{1,100}), triggered by event: ([a-z_]{1,40})$"
)
SIZED_RE = re.compile(r"^(ci-heavy-main|ci-heavy|ci-protected)-(cpu[0-9]{1,3}-ram[0-9]{1,4}g)$")
LEGACY_CLASSES = (
    ("heavy-main", {"ci-heavy-main"}),
    ("heavy", {"ci-heavy"}),
    ("protected", {"ci-protected", "ci-protected-tailnet", "ci-protected-metal"}),
    ("lite", {"ci-lite", "ubuntu-latest"}),
)
SELECTED_CLASSES = {"heavy-main", "heavy", "protected", "lite",
                    "sized-heavy-main", "sized-heavy", "sized-protected"}
CI_NAMESPACES = {"forgejo-ci", "forgejo-ci-protected", "forgejo-ci-untrusted"}
POD_RE = re.compile(
    r"^(forgejo-ci-ephemeral|forgejo-ci-protected|forgejo-ci-lite)-([0-9]{1,2})-[a-z0-9]{5}$")
NODE_RE = re.compile(r"^[a-z0-9][a-z0-9.-]{0,252}$")
# The one-job runner logs this line in its own container when it takes a task.
RUNNER_TASK_RE = re.compile(
    r'^time="[0-9TZ:.+-]{1,40}" level=info msg="task ([1-9][0-9]{0,15}) repo is '
    r'([A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}) ')
LOKI_ENTRY_LIMIT = 5000
MAX_PLACEMENT_LINES = 400000


class CollectorFailure(RuntimeError):
    """A value-blind collector failure."""


def load_dispatcher(environ: dict[str, str]):
    # Only the infrastructure repository has the runner dispatcher the placement
    # join needs; FORGEJO_RUNNER_DISPATCHER names that checkout's dispatcher.py.
    path = environ.get("FORGEJO_RUNNER_DISPATCHER", "")
    if not path:
        raise CollectorFailure("FORGEJO_RUNNER_DISPATCHER must name the runner dispatcher.py")
    spec = importlib.util.spec_from_file_location("forgejo_start_latency_dispatcher", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def parse_time(value: Any) -> datetime | None:
    """Forgejo times; its zero time and empty values mean "not set"."""
    if value in (None, "") or not isinstance(value, str):
        return None
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as error:
        raise CollectorFailure("Forgejo returned a malformed timestamp") from error
    if parsed.tzinfo is None:
        raise CollectorFailure("Forgejo returned a timestamp without a zone")
    if parsed.year < 2000:
        return None
    return parsed.astimezone(timezone.utc)


def iso(value: datetime | None) -> str | None:
    return None if value is None else value.isoformat().replace("+00:00", "Z")


def interval(start: datetime | None, end: datetime | None) -> float | None:
    # Clock order must agree across API, runner and controller clocks;
    # a negative interval is unknown, never zero.
    if start is None or end is None or end < start:
        return None
    return round((end - start).total_seconds(), 3)


def read_token(token_file: str | None, environ: dict[str, str]) -> str:
    if token_file is not None:
        try:
            info = os.lstat(token_file)
        except OSError as error:
            raise CollectorFailure("token file is unreadable") from error
        if not stat.S_ISREG(info.st_mode):
            raise CollectorFailure("token file must be a regular file, not a link")
        if info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise CollectorFailure("token file must be owned by the caller with mode 0600")
        if info.st_size > 4096:
            raise CollectorFailure("token file exceeds the bounded size")
        try:
            value = Path(token_file).read_text(encoding="utf-8").strip()
        except (OSError, UnicodeDecodeError) as error:
            raise CollectorFailure("token file is unreadable") from error
    elif environ.get("CI") == "true":
        value = (environ.get("GITEA_TOKEN") or environ.get("FORGEJO_TOKEN") or "").strip()
    else:
        raise CollectorFailure("pass --token-file, or run in a Forgejo job with its job token")
    if not TOKEN_RE.fullmatch(value):
        raise CollectorFailure("token has an invalid shape")
    return value


def read_bounded(response: Any, limit: int) -> bytes:
    payload = response.read(limit + 1)
    if len(payload) > limit:
        raise CollectorFailure("Forgejo response exceeded the bounded size")
    return payload


def api_base(environ: dict[str, str]) -> str:
    """The Forgejo API root, from GITHUB_SERVER_URL (set in every Forgejo job)."""
    server_url = environ.get("GITHUB_SERVER_URL", "")
    if not SERVER_URL_RE.fullmatch(server_url):
        raise CollectorFailure("GITHUB_SERVER_URL must be the Forgejo base URL, for example https://forgejo.example.com")
    return server_url.rstrip("/") + "/api/v1"


def http_transport(token: str, api: str) -> Callable[[str, str], tuple[int, bytes]]:
    context = ssl.create_default_context()

    def transport(kind: str, path: str) -> tuple[int, bytes]:
        request = urllib.request.Request(
            f"{api}{path}",
            headers={
                "Accept": "application/json" if kind in {"runs", "jobs", "job"} else "*/*",
                "Authorization": f"token {token}",
                "User-Agent": "noel-infra-forgejo-ci-start-latency/1",
            },
            method="GET",
        )
        limit = MAX_JSON_BYTES if kind in {"runs", "jobs", "job"} else MAX_TEXT_BYTES
        try:
            with urllib.request.urlopen(request, context=context, timeout=30) as response:
                return response.status, read_bounded(response, limit)
        except urllib.error.HTTPError as error:
            error.close()
            return error.code, b""
        except (OSError, urllib.error.URLError) as error:
            raise CollectorFailure(f"Forgejo {kind} transport failed") from error

    return transport


class Forgejo:
    """GET-only client bound to the allowlisted read paths."""

    def __init__(self, transport: Callable[[str, str], tuple[int, bytes]]) -> None:
        self.transport = transport
        self.requests = 0

    def get(self, kind: str, path: str, *, missing_ok: bool = False) -> bytes | None:
        if PATHS[kind].fullmatch(path) is None:
            raise CollectorFailure(f"refusing Forgejo {kind} path outside the read allowlist")
        self.requests += 1
        code, payload = self.transport(kind, path)
        if code == 404 and missing_ok:
            return None
        if code != 200:
            raise CollectorFailure(f"Forgejo {kind} read returned HTTP {code}")
        return payload

    def get_json(self, kind: str, path: str) -> Any:
        payload = self.get(kind, path)
        try:
            return json.loads(payload)
        except (TypeError, ValueError) as error:
            raise CollectorFailure(f"Forgejo {kind} returned malformed JSON") from error


def positive_int(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and value > 0


def main_push_runs(forgejo: Forgejo, repo: str, since: datetime, until: datetime) -> list[dict]:
    runs: list[dict] = []
    seen: set[int] = set()
    for page in range(1, MAX_RUN_PAGES + 1):
        document = forgejo.get_json(
            "runs",
            f"/repos/{repo}/actions/runs?event=push&ref=refs%2Fheads%2Fmain"
            f"&page={page}&limit={RUN_PAGE_LIMIT}",
        )
        items = document.get("workflow_runs") if isinstance(document, dict) else None
        if not isinstance(items, list) or len(items) > RUN_PAGE_LIMIT:
            raise CollectorFailure("run list response had an invalid shape")
        oldest = None
        for run in items:
            if not isinstance(run, dict) or not positive_int(run.get("id")):
                raise CollectorFailure("run list item had an invalid shape")
            created = parse_time(run.get("created"))
            if created is None:
                raise CollectorFailure("run list item had no creation time")
            oldest = created if oldest is None else min(oldest, created)
            if run["id"] in seen or not since <= created < until:
                continue
            # The filter is server-side; keep only what it promised.
            if run.get("event") != "push" or run.get("prettyref") not in {"main", "refs/heads/main"}:
                continue
            seen.add(run["id"])
            runs.append(run)
        if len(items) < RUN_PAGE_LIMIT or (oldest is not None and oldest < since):
            return sorted(runs, key=lambda run: run["id"])
    raise CollectorFailure("run list exceeded the bounded pagination limit")


def run_jobs(forgejo: Forgejo, repo: str, run_id: int) -> list[dict]:
    document = forgejo.get_json(
        "jobs", f"/repos/{repo}/actions/runs/{run_id}/jobs?page=1&limit={JOB_PAGE_LIMIT}")
    if isinstance(document, dict) and isinstance(document.get("jobs"), list):
        document = document["jobs"]
    if not isinstance(document, list) or len(document) >= JOB_PAGE_LIMIT:
        raise CollectorFailure("run job list had an invalid or unbounded shape")
    jobs = []
    for job in document:
        if (not isinstance(job, dict) or not positive_int(job.get("id"))
                or job.get("run_id", run_id) != run_id):
            raise CollectorFailure("run job item had an invalid identity")
        jobs.append(job)
    return jobs


def job_steps(forgejo: Forgejo, repo: str, job_id: int) -> list[dict]:
    document = forgejo.get_json("job", f"/repos/{repo}/actions/jobs/{job_id}")
    if not isinstance(document, dict) or document.get("id") != job_id:
        raise CollectorFailure("job response had an invalid identity")
    steps = document.get("steps") or []
    if not isinstance(steps, list) or len(steps) > MAX_STEPS:
        raise CollectorFailure("job steps had an invalid shape")
    result = []
    for step in steps:
        if (not isinstance(step, dict) or not isinstance(step.get("number"), int)
                or isinstance(step.get("number"), bool) or step["number"] < 0):
            raise CollectorFailure("job step had an invalid shape")
        name = step.get("name")
        result.append({
            "number": step["number"],
            "name": name[:200] if isinstance(name, str) else None,
            "status": step.get("status") if isinstance(step.get("status"), str) else None,
            "started": parse_time(step.get("started")),
            "stopped": parse_time(step.get("stopped")),
        })
    return sorted(result, key=lambda step: step["number"])


def parse_header(payload: bytes | None) -> dict | None:
    """Exactly one strict runner header, or unknown. Never echo the input."""
    if not payload:
        return None
    try:
        text = payload.decode("utf-8")
    except UnicodeDecodeError:
        return None
    found = set()
    for line in text.splitlines()[:1000]:
        if not line.strip():
            continue
        try:
            record = json.loads(line)
        except ValueError:
            return None
        content = record.get("content") if isinstance(record, dict) else None
        match = HEADER_RE.fullmatch(content) if isinstance(content, str) else None
        if match is not None:
            found.add(match.groups())
    if len(found) != 1:
        return None
    uuid, version, task, key, event = found.pop()
    return {"runner_uuid": uuid, "runner_version": version, "task_id": int(task),
            "job_key": key, "event": event}


def workflow_names(forgejo: Forgejo, repo: str, workflow: Any, sha: Any) -> dict[str, str]:
    """Plain YAML job names to keys, for jobs that never ran and have no header."""
    if (not isinstance(workflow, str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,100}\.ya?ml", workflow)
            or not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{40}", sha)):
        return {}
    try:
        import yaml
    except ImportError:
        return {}
    for directory in (".forgejo", ".gitea"):
        payload = forgejo.get("workflow", f"/repos/{repo}/raw/{directory}/workflows/{workflow}?ref={sha}",
                              missing_ok=True)
        if payload is None:
            continue
        try:
            document = yaml.safe_load(payload)
        except yaml.YAMLError:
            return {}
        jobs = document.get("jobs") if isinstance(document, dict) else None
        if not isinstance(jobs, dict):
            return {}
        names: dict[str, list[tuple[str, bool]]] = {}
        for key, spec in jobs.items():
            if not isinstance(key, str) or not isinstance(spec, dict):
                continue
            name = spec.get("name", key)
            if not isinstance(name, str) or "${{" in name:
                continue
            matrix = isinstance(spec.get("strategy"), dict) and "matrix" in spec["strategy"]
            names.setdefault(name, []).append((key, matrix))
        return {name: entries[0] for name, entries in names.items() if len(entries) == 1}
    return {}


def name_key(name: Any, mapping: dict) -> str | None:
    if not isinstance(name, str):
        return None
    entry = mapping.get(name)
    if entry is not None:
        return entry[0]
    # Forgejo appends " (values)" to a matrix job whose name has no expression.
    if name.endswith(")") and " (" in name:
        entry = mapping.get(name[: name.index(" (")])
        if entry is not None and entry[1]:
            return entry[0]
    return None


def classify(runs_on: Any) -> tuple[str, str | None]:
    labels = runs_on if isinstance(runs_on, list) else [runs_on] if isinstance(runs_on, str) else []
    labels = {label for label in labels if isinstance(label, str)}
    classes = set()
    size = None
    for label in labels:
        match = SIZED_RE.fullmatch(label)
        if match is not None:
            classes.add("sized-" + match.group(1).removeprefix("ci-"))
            size = match.group(2)
    for name, aliases in LEGACY_CLASSES:
        if aliases & labels:
            classes.add(name)
    if len(classes) == 1:
        return classes.pop(), size
    return ("ambiguous" if classes else "other"), size


def run_rows(forgejo: Forgejo, repo: str, run: dict) -> list[dict]:
    run_id = run["id"]
    created = parse_time(run.get("created"))
    jobs = run_jobs(forgejo, repo, run_id)
    facts: dict[int, dict] = {}
    for job in jobs:
        status = job.get("status")
        steps: list[dict] = []
        header = None
        # A job that never reached a runner has no steps and no log.
        if status not in {"skipped", "blocked", "waiting"}:
            steps = job_steps(forgejo, repo, job["id"])
            attempt = job.get("attempt") if positive_int(job.get("attempt")) else 1
            if steps:
                header = parse_header(forgejo.get(
                    "header",
                    f"/repos/{repo}/actions/jobs/{job['id']}/logs?attempt={attempt}"
                    "&step=0&q=received%20task&format=ndjson",
                    missing_ok=True,
                ))
        facts[job["id"]] = {"job": job, "steps": steps, "header": header}
    mapping = None
    for fact in facts.values():
        if fact["header"] is not None:
            fact["key"] = fact["header"]["job_key"]
            continue
        if mapping is None:
            mapping = workflow_names(forgejo, repo, run.get("workflow_id"), run.get("commit_sha"))
        fact["key"] = name_key(fact["job"].get("name"), mapping)
    by_key: dict[str, list[dict]] = {}
    for fact in facts.values():
        if fact["key"] is not None:
            by_key.setdefault(fact["key"], []).append(fact)

    def stopped(fact: dict) -> datetime | None:
        times = [step["stopped"] for step in fact["steps"] if step["stopped"] is not None]
        return max(times) if times else None

    def eligible(fact: dict, depth: int = 0) -> tuple[datetime | None, str]:
        job = fact["job"]
        attempt = job.get("attempt")
        if positive_int(attempt) and attempt > 1:
            return None, "rerun"
        needs = job.get("needs") or []
        if not isinstance(needs, list) or not all(isinstance(need, str) for need in needs):
            return None, "unknown"
        if not needs:
            return created, "run-created"
        if depth > 32:
            return None, "unknown"
        times = []
        for need in needs:
            needed = by_key.get(need)
            if not needed:
                return None, "unknown"
            for other in needed:
                # A skipped job resolves when its own needs resolve.
                if other["job"].get("status") == "skipped":
                    value, _ = eligible(other, depth + 1)
                else:
                    value = stopped(other)
                if value is None:
                    return None, "unknown"
                times.append(value)
        return max(times), "needs-complete"

    rows = []
    for fact in facts.values():
        job = fact["job"]
        if job.get("status") == "skipped":
            continue
        job_class, size = classify(job.get("runs_on"))
        if job_class not in SELECTED_CLASSES:
            continue
        steps = fact["steps"]
        eligible_at, basis = eligible(fact)
        assigned_at = next((step["started"] for step in steps if step["number"] == 0), None)
        first_command_at = next(
            (step["started"] for step in steps if step["number"] >= 1 and step["started"] is not None),
            None)
        stopped_at = stopped(fact)
        header = fact["header"] or {}
        name = job.get("name")
        rows.append({
            "schema_version": 1,
            "repo": repo,
            "run_id": run_id,
            "run_number": run.get("index_in_repo") if positive_int(run.get("index_in_repo")) else None,
            "workflow": run.get("workflow_id") if isinstance(run.get("workflow_id"), str) else None,
            "head_sha": run.get("commit_sha") if isinstance(run.get("commit_sha"), str) else None,
            "job_id": job["id"],
            "name": name[:200] if isinstance(name, str) else None,
            "job_key": fact["key"],
            "attempt": job.get("attempt") if positive_int(job.get("attempt")) else None,
            "status": job.get("status") if isinstance(job.get("status"), str) else None,
            "runs_on": sorted(label for label in (job.get("runs_on") or []) if isinstance(label, str))
            if isinstance(job.get("runs_on"), list) else None,
            "class": job_class,
            "size": size,
            "kind": isinstance(name, str) and "Kind" in name,
            "eligible_at": iso(eligible_at),
            "eligible_basis": basis if eligible_at is not None else ("rerun" if basis == "rerun" else "unknown"),
            "assigned_at": iso(assigned_at),
            "first_command_at": iso(first_command_at),
            "stopped_at": iso(stopped_at),
            "eligible_to_assigned_s": interval(eligible_at, assigned_at),
            "eligible_to_first_command_s": interval(eligible_at, first_command_at),
            "setup_s": interval(assigned_at, first_command_at),
            "duration_s": interval(assigned_at, stopped_at),
            "steps": [
                {"number": step["number"], "name": step["name"], "status": step["status"],
                 "duration_s": interval(step["started"], step["stopped"])}
                for step in steps
            ],
            "runner_uuid": header.get("runner_uuid"),
            "runner_version": header.get("runner_version"),
            "task_id": header.get("task_id"),
            "job_task_id": job.get("task_id") if positive_int(job.get("task_id")) else None,
            "placement": None,
            "capacity": "unknown",
        })
    return rows


def placement_identity(namespace: str, pod: str, dispatcher) -> dict | None:
    match = POD_RE.fullmatch(pod)
    if match is None or namespace not in CI_NAMESPACES:
        return None
    prefix, index = match.group(1), int(match.group(2))
    try:
        if prefix == "forgejo-ci-ephemeral" and namespace == "forgejo-ci":
            slot = dispatcher.HEAVY_SLOTS[index]
            if slot in dispatcher.HEAVY_RETIRED_SLOTS:
                return None
            return {"worker": f"{prefix}-{index}", "dispatcher_slot": slot,
                    "pool": dispatcher.heavy_node_pool(slot), "profile": dispatcher.heavy_profile(slot),
                    "host": None}
        if prefix == "forgejo-ci-protected" and namespace == "forgejo-ci-protected":
            slot = dispatcher.PROTECTED_SLOTS[index]
            metal = slot in dispatcher.PROTECTED_METAL_SLOTS
            return {"worker": f"{prefix}-{index}", "dispatcher_slot": slot,
                    "pool": dispatcher.protected_node_pool(slot),
                    "profile": dispatcher.protected_profile(slot),
                    "host": dispatcher.PROTECTED_METAL_NODE if metal else None}
        if prefix == "forgejo-ci-lite" and namespace == "forgejo-ci-untrusted":
            slot = dispatcher.UNTRUSTED_SLOTS[index]
            return {"worker": f"{prefix}-{index}", "dispatcher_slot": slot,
                    "pool": "ci-untrusted", "profile": dispatcher.LITE_PROFILE_LABEL, "host": None}
    except (IndexError, ValueError):
        return None
    return None


def load_placements(path: str) -> dict[int, dict]:
    placements: dict[int, dict] = {}
    try:
        lines = Path(path).read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError) as error:
        raise CollectorFailure("placement file is unreadable") from error
    if len(lines) > MAX_PLACEMENT_LINES:
        raise CollectorFailure("placement file exceeds the bounded size")
    for line in lines:
        if not line.strip():
            continue
        try:
            record = json.loads(line)
        except ValueError as error:
            raise CollectorFailure("placement file has a malformed record") from error
        if (not isinstance(record, dict) or not positive_int(record.get("task_id"))
                or not isinstance(record.get("pod"), str) or not isinstance(record.get("namespace"), str)
                or not isinstance(record.get("repo"), str)):
            raise CollectorFailure("placement record has an invalid shape")
        if record["task_id"] in placements:
            raise CollectorFailure("placement file repeats a task")
        placements[record["task_id"]] = record
    return placements


def join_placement(row: dict, placements: dict[int, dict], dispatcher) -> None:
    task = row.get("task_id")
    record = placements.get(task) if task is not None else None
    if record is None or record["repo"] != row["repo"] or row.get("job_task_id") not in (None, task):
        return
    identity = placement_identity(record["namespace"], record["pod"], dispatcher)
    if identity is None:
        return
    node = record.get("node") if isinstance(record.get("node"), str) and NODE_RE.fullmatch(record["node"]) else None
    row["placement"] = {"namespace": record["namespace"], "pod": record["pod"], **identity,
                        "node": node or identity["host"]}
    ready = parse_time(record.get("ready_at")) if isinstance(record.get("ready_at"), str) else None
    eligible_at = parse_time(row.get("eligible_at"))
    if ready is not None and eligible_at is not None:
        # Warm: the worker that took the job had finished its preload before
        # the job became eligible.
        row["capacity"] = "warm" if ready <= eligible_at else "cold"


def collect(arguments, environ, transport_factory=None) -> list[dict]:
    if arguments.repo not in REPOSITORIES:
        raise CollectorFailure("repository is outside the collector allowlist")
    try:
        since, until = (parse_time(value) for value in (arguments.since, arguments.until))
    except CollectorFailure:
        since = until = None
    if since is None or until is None or not since < until or until - since > MAX_WINDOW:
        raise CollectorFailure("window must be ordered, zoned and at most 31 days")
    placements = load_placements(arguments.placements) if arguments.placements else {}
    dispatcher = load_dispatcher(environ) if placements else None
    factory = (lambda token: http_transport(token, api_base(environ))) if transport_factory is None \
        else transport_factory
    forgejo = Forgejo(factory(read_token(arguments.token_file, environ)))
    rows = []
    for run in main_push_runs(forgejo, arguments.repo, since, until):
        for row in run_rows(forgejo, arguments.repo, run):
            if placements:
                join_placement(row, placements, dispatcher)
            rows.append(row)
    return rows


def reduce_loki(documents: list[Any]) -> list[dict]:
    """Trusted runner and preloader streams to task placements."""
    tasks: dict[int, set[tuple[str, str, str]]] = {}
    nodes: dict[tuple[str, str], set[str]] = {}
    ready: dict[tuple[str, str], str] = {}
    for document in documents:
        result = ((document or {}).get("data") or {}).get("result") if isinstance(document, dict) else None
        if not isinstance(document, dict) or document.get("status") != "success" or not isinstance(result, list):
            raise CollectorFailure("Loki response had an invalid shape")
        if sum(len(stream.get("values") or []) for stream in result if isinstance(stream, dict)) >= LOKI_ENTRY_LIMIT:
            raise CollectorFailure("Loki response may be truncated; query a shorter window")
        for stream in result:
            labels = stream.get("stream") if isinstance(stream, dict) else None
            values = stream.get("values") if isinstance(stream, dict) else None
            if not isinstance(labels, dict) or not isinstance(values, list):
                raise CollectorFailure("Loki stream had an invalid shape")
            namespace, pod = labels.get("namespace"), labels.get("pod")
            if namespace not in CI_NAMESPACES or not isinstance(pod, str) or POD_RE.fullmatch(pod) is None:
                continue
            for value in values:
                if not isinstance(value, list) or len(value) != 2 or not isinstance(value[1], str):
                    raise CollectorFailure("Loki entry had an invalid shape")
                line = value[1]
                match = RUNNER_TASK_RE.match(line)
                if match is not None:
                    tasks.setdefault(int(match.group(1)), set()).add((match.group(2), namespace, pod))
                    continue
                if not line.startswith("{"):
                    continue
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if (not isinstance(event, dict) or event.get("event") != "forgejo_runner_phase"
                        or event.get("source") != "preloader" or event.get("pod") != pod):
                    continue
                if isinstance(event.get("node"), str) and NODE_RE.fullmatch(event["node"]):
                    nodes.setdefault((namespace, pod), set()).add(event["node"])
                if (event.get("phase") == "preload_complete" and event.get("outcome") == "success"
                        and isinstance(event.get("timestamp"), str)):
                    parse_time(event["timestamp"])
                    ready[(namespace, pod)] = event["timestamp"]
    placements = []
    for task, seen in sorted(tasks.items()):
        if len(seen) != 1:
            continue  # Conflicting streams for one task stay unknown.
        repo, namespace, pod = next(iter(seen))
        pod_nodes = nodes.get((namespace, pod), set())
        placements.append({"task_id": task, "repo": repo, "namespace": namespace, "pod": pod,
                           "node": next(iter(pod_nodes)) if len(pod_nodes) == 1 else None,
                           "ready_at": ready.get((namespace, pod))})
    return placements


def percentile(values: list[float], fraction: float) -> float | None:
    if not values:
        return None
    ordered = sorted(values)
    return ordered[max(0, math.ceil(fraction * len(ordered)) - 1)]


def summarize(rows: list[dict]) -> dict:
    groups: dict[str, list[dict]] = {}
    for row in rows:
        groups.setdefault(row["class"], []).append(row)
        if row.get("kind"):
            groups.setdefault(f"{row['class']}/kind", []).append(row)
    summary = {}
    for name, members in sorted(groups.items()):
        entry = {"jobs": len(members),
                 "eligible_unknown": sum(row.get("eligible_at") is None for row in members),
                 "never_assigned": sum(row.get("assigned_at") is None for row in members),
                 "placement_known": sum(row.get("placement") is not None for row in members)}
        for field in ("eligible_to_first_command_s", "eligible_to_assigned_s", "setup_s", "duration_s"):
            values = [row[field] for row in members if isinstance(row.get(field), (int, float))]
            entry[field] = {"n": len(values), "p50": percentile(values, 0.5), "p95": percentile(values, 0.95)}
        for capacity in ("warm", "cold"):
            values = [row["eligible_to_first_command_s"] for row in members
                      if row.get("capacity") == capacity
                      and isinstance(row.get("eligible_to_first_command_s"), (int, float))]
            entry[f"{capacity}_eligible_to_first_command_s"] = {
                "n": len(values), "p50": percentile(values, 0.5), "p95": percentile(values, 0.95)}
        summary[name] = entry
    return {"schema_version": 1, "classes": summary}


def read_jsonl(stream, *, limit: int = MAX_PLACEMENT_LINES) -> list[Any]:
    records = []
    for number, line in enumerate(stream, 1):
        if number > limit or len(line) > MAX_JSON_BYTES:
            raise CollectorFailure("input exceeds the bounded size")
        if line.strip():
            try:
                records.append(json.loads(line))
            except ValueError as error:
                raise CollectorFailure("input has a malformed record") from error
    return records


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="forgejo-ci-start-latency", description=__doc__.splitlines()[0])
    commands = root.add_subparsers(dest="command", required=True)
    collect_command = commands.add_parser("collect", help="read main push job timings")
    collect_command.add_argument("--repo", required=True, choices=REPOSITORIES)
    collect_command.add_argument("--since", required=True, help="UTC start, e.g. 2026-10-20T00:00:00Z")
    collect_command.add_argument("--until", required=True, help="UTC end, at most 31 days later")
    collect_command.add_argument("--token-file", help="mode-0600 file holding a read token")
    collect_command.add_argument("--placements", help="JSONL from the placements command")
    commands.add_parser("placements", help="Loki query_range JSONL on stdin to placement JSONL")
    commands.add_parser("summary", help="collected rows on stdin to per-class percentiles")
    return root


def main(argv: list[str] | None = None, environ: dict[str, str] | None = None) -> int:
    arguments = parser().parse_args(argv)
    try:
        if arguments.command == "collect":
            output = collect(arguments, dict(os.environ) if environ is None else environ)
        elif arguments.command == "placements":
            output = reduce_loki(read_jsonl(sys.stdin, limit=10000))
        else:
            output = [summarize(read_jsonl(sys.stdin))]
        for record in output:
            print(json.dumps(record, separators=(",", ":"), sort_keys=True))
        return 0
    except CollectorFailure as error:
        print(f"forgejo-ci-start-latency: ERROR {error}", file=sys.stderr)
        return 1
    except Exception:
        print("forgejo-ci-start-latency: ERROR unexpected failure", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
