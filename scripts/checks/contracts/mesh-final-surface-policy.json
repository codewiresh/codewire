{
  "$comment": "Permanent WS18 WI-9B Mesh guard. Mesh exposes generated codewire.v1 Connect services, the typed internal coordinator, and health/readiness only; all former Mesh REST and Mesh-owned browser auth/session/device paths are retired.",
  "schema_version": 1,
  "required_server_fragments": [
    "AppBuilder::new(\"mesh\")",
    ".with_health()",
    ".with_connect_routes(crate::connect::router(state.clone()))",
    "crate::mesh_coordinate::router(state)",
    "ProtocolPolicy::ConnectAndGrpc"
  ],
  "forbidden_server_fragments": [
    ".route(",
    "axum::routing",
    "/api/v1/",
    "/auth/oidc",
    "/auth/session",
    "sess_",
    "AuthMode",
    "auth_token"
  ],
  "required_source_fragments": {
    "crates/codewire-mesh/src/config.rs": [
      "MESH_AUTHORIZATION_URL_ENV",
      "MESH_AUTHORIZATION_HMAC_SECRET_ENV",
      "LOCAL_API_KEY_HASH_ENV",
      "LOCAL_ENVIRONMENT_TOKEN_HASH_ENV"
    ],
    "crates/codewire-mesh/src/mesh_authorization.rs": [
      "MeshAuthorizationAdapter",
      "FORWARDED_AUTHORIZATION_HEADER",
      "FORWARDED_SESSION_HEADER"
    ],
    "crates/codewire-mesh/src/store.rs": [
      "async fn node_enrollment_create",
      "async fn invite_create",
      "async fn network_create_owned"
    ],
    "crates/codewire-cli/src/commands/mesh_commands.rs": [
      "CODEWIRE_MESH_LOCAL_API_KEY_HASH",
      "CODEWIRE_MESH_LOCAL_ENVIRONMENT_TOKEN_HASH"
    ]
  },
  "forbidden_source_fragments": {
    "crates/codewire-mesh/src/config.rs": [
      "AUTH_MODE_ENV",
      "AUTH_TOKEN_ENV",
      "OIDC_ISSUER_ENV",
      "OIDC_CLIENT_ID_ENV",
      "OIDC_CLIENT_SECRET_ENV"
    ],
    "crates/codewire-mesh/src/lib.rs": [
      "AuthMode",
      "SessionIdentity",
      "OidcSession"
    ],
    "crates/codewire-mesh/src/store.rs": [
      "async fn session_identity",
      "async fn user_get_by_username",
      "async fn oauth_state_create",
      "async fn oidc_user_upsert",
      "async fn oidc_session_create"
    ],
    "crates/codewire-cli/src/commands/mesh_commands.rs": [
      ".env(\"CODEWIRE_MESH_AUTH_MODE\"",
      ".env(\"CODEWIRE_MESH_AUTH_TOKEN\""
    ],
    "tests/e2e/kind/mesh.yaml": [
      "--auth-mode="
    ]
  },
  "absent_paths": [
    "crates/codewire-mesh/src/auth.rs",
    "apps/cli/charts/codewire-mesh/templates/secret.yaml",
    "deployments/k8s/flux/production/mesh-oidc-bootstrap-job.yaml",
    "deployments/k8s/mesh-production/values-oidc.yaml"
  ],
  "forbidden_edge_fragments": {
    "Caddyfile": ["@mesh_networks", "/api/v1/networks"],
    "Caddyfile.docker": ["@mesh_networks", "/api/v1/networks"],
    "deployments/k8s/base/ingress.yaml": ["/api/v1/networks"],
    "deployments/k8s/overlays/local-kind/ingress.yaml": ["/api/v1/networks"],
    "deployments/k8s/overlays/local-kind-static/ingress.yaml": ["/api/v1/networks"],
    "tests/e2e/kind/ingress.yaml": ["/api/v1/networks"]
  }
}
