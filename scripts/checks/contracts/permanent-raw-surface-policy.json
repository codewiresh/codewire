{
  "$comment": "Permanent Connect-RPC raw HTTP policy. Generated Connect owns every control-plane procedure; this exact list is limited to identity/OIDC, third-party webhooks, browser terminal/SSH transports, the session-owned preview browser handoff, and probes.",
  "schema_version": 1,
  "allowed_raw_routes": [
    "/.well-known/jwks.json",
    "/.well-known/oauth-authorization-server",
    "/.well-known/openid-configuration",
    "/api/admin/accounts",
    "/api/admin/accounts/{user_id}/enabled",
    "/api/admin/accounts/{user_id}/resend-verification",
    "/api/auth/forget-password",
    "/api/auth/get-session",
    "/api/auth/oauth/identities",
    "/api/auth/oauth/identities/link",
    "/api/auth/oauth/identities/unlink",
    "/api/auth/oauth/link/confirm",
    "/api/auth/oauth/link/pending",
    "/api/auth/oauth/providers",
    "/api/auth/oauth/signup/complete",
    "/api/auth/oauth/signup/pending",
    "/api/auth/oauth/{provider}/callback",
    "/api/auth/oauth/{provider}/start",
    "/api/auth/resend-verification",
    "/api/auth/reset-password",
    "/api/auth/send-verification-email",
    "/api/auth/sessions",
    "/api/auth/sessions/revoke",
    "/api/auth/sign-in",
    "/api/auth/sign-out",
    "/api/auth/sign-up",
    "/api/auth/sign-up/mode",
    "/api/auth/two-factor/disable",
    "/api/auth/two-factor/enable",
    "/api/auth/two-factor/recovery-codes/regenerate",
    "/api/auth/two-factor/replace/confirm",
    "/api/auth/two-factor/replace/start",
    "/api/auth/two-factor/skip-setup",
    "/api/auth/two-factor/validate",
    "/api/auth/two-factor/verify",
    "/api/auth/verify-email",
    "/api/oauth/authorize",
    "/api/oauth/device_authorization",
    "/api/oauth/device_verification",
    "/api/oauth/end_session",
    "/api/oauth/introspect",
    "/api/oauth/revoke",
    "/api/oauth/token",
    "/api/oauth/userinfo",
    "/api/oidc/callback",
    "/api/v1/organizations/{org_id}/environments/{env_id}/ssh-proxy",
    "/api/v1/organizations/{org_id}/environments/{env_id}/ssh-proxy/check",
    "/api/v1/organizations/{org_id}/environments/{env_id}/terminal",
    "/api/v1/preview-auth/authorize",
    "/api/webhooks/stripe",
    "/healthz",
    "/healthz/stripe-webhook-delivery",
    "/healthz/stripe-webhook-endpoint",
    "/readyz"
  ],
  "required_server_fragments": {
    "crates/codewire-orchestration/src/main.rs": [
      "AppBuilder::new(\"codewire-orchestration\")",
      ".with_health_and_db_probe(pool.clone(), move || {",
      ".with_routes(codewire_orchestration::api::router(api_state.clone(), auth))"
    ],
    "crates/codewire-billing/src/main.rs": [
      "AppBuilder::new(\"codewire-billing\")",
      ".with_health_and_db(pool.clone())",
      ".with_routes(codewire_billing::router(state))"
    ],
    "crates/codewire-idp/src/main.rs": [
      "AppBuilder::new(\"codewire-idp\")",
      ".with_health_and_db(pool)",
      ".merge(oidc)"
    ],
    "crates/codewire-coordinator/src/main.rs": [
      "AppBuilder::new(\"codewire-coordinator\")",
      ".with_health_and_db(pool)",
      ".with_routes(router(state, auth))"
    ],
    "crates/codewire-mesh/src/server.rs": [
      "AppBuilder::new(\"mesh\")",
      ".with_health()",
      ".with_connect_routes(crate::connect::router(state.clone()))"
    ]
  },
  "oidc_config_route_count": 8,
  "client_raw_v1_suffixes": [
    "/ssh-proxy",
    "/terminal"
  ]
}
