#!/usr/bin/env bash
# Pre-push dispatcher: resolve the pushing worktree and run its own policy
# (scripts/dev/pre-push.sh).
# Install via `bun run hooks:install` (copies this dispatcher into the common
# Git directory so deleting the installing worktree cannot break every hook).

set -euo pipefail

if ! INVOKING_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" ||
  [ -z "$INVOKING_ROOT" ]; then
  echo "pre-push: could not resolve the invoking worktree root" >&2
  exit 1
fi

# A worktree that owns its pre-push policy decides everything itself, so the
# policy versions with the tree it verifies and this copy rarely changes.
WORKTREE_HOOK="$INVOKING_ROOT/scripts/dev/pre-push.sh"
if [ -x "$WORKTREE_HOOK" ]; then
  exec "$WORKTREE_HOOK" "$@"
fi

echo "pre-push: this worktree has no executable scripts/dev/pre-push.sh; update it from main" >&2
exit 1
