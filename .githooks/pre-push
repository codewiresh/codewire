#!/usr/bin/env bash
# Pre-push dispatcher: resolve the pushing worktree and validate its receipt.
# Install via `bun run hooks:install` (copies this dispatcher into the common
# Git directory so deleting the installing worktree cannot break every hook).

set -euo pipefail

if ! INVOKING_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" ||
  [ -z "$INVOKING_ROOT" ]; then
  echo "pre-push: could not resolve the invoking worktree root" >&2
  exit 1
fi

PREFLIGHT="$INVOKING_ROOT/scripts/dev/preflight.sh"
LOCAL_RECEIPT="$INVOKING_ROOT/scripts/ci/receipts/local-prepush-receipt.py"
if [ ! -x "$PREFLIGHT" ]; then
  echo "pre-push: invoking worktree has no executable scripts/dev/preflight.sh" >&2
  exit 1
fi
if [ ! -x "$LOCAL_RECEIPT" ]; then
  # The dispatcher is shared by every linked worktree. During the one-commit
  # migration window, an older worktree may not contain the receipt verifier;
  # retain its fail-closed full preflight instead of breaking that worktree.
  exec "$PREFLIGHT"
fi

preflight_mode="${CODEWIRE_PREFLIGHT_MODE:-default}"
case "$preflight_mode" in
  default|integration|kind|full) ;;
  *)
    echo "pre-push: CODEWIRE_PREFLIGHT_MODE must be default, integration, kind, or full" >&2
    exit 2
    ;;
esac
export CODEWIRE_PREFLIGHT_MODE="$preflight_mode"

push_count=0
local_ref=""
head_sha=""
base_sha=""
remote_ref=""
if [ ! -t 0 ]; then
  while read -r candidate_local_ref candidate_head candidate_remote_ref candidate_base; do
    [ -n "${candidate_head:-}" ] || continue
    push_count=$((push_count + 1))
    local_ref="$candidate_local_ref"
    head_sha="$candidate_head"
    base_sha="$candidate_base"
    remote_ref="$candidate_remote_ref"
  done
fi

if [ "$push_count" -gt 1 ]; then
  echo "pre-push: multi-ref pushes are unsupported; push one ref at a time" >&2
  exit 1
elif [ "$push_count" -eq 1 ]; then
  if [[ "$head_sha" =~ ^0+$ ]]; then
    exit 0
  fi
  export PREFLIGHT_HEAD_SHA="$head_sha"
  if [[ "$local_ref" =~ ^refs/tags/v[0-9]+\.[0-9]+\.[0-9]+$ ]] \
    && [ "$remote_ref" = "$local_ref" ]; then
    export PREFLIGHT_RELEASE_TAG_REF="$local_ref"
    export PREFLIGHT_RELEASE_TAG_OBJECT_SHA="$head_sha"
    export PREFLIGHT_PUSH_REMOTE_NAME="${1:-}"
    export PREFLIGHT_RECEIPT_ONLY=true
    exec "$PREFLIGHT"
  fi
  # Feature branches are always compared with canonical main so the local
  # selection matches pull-request CI. A direct main push compares the exact
  # remote before/after range supplied by Git.
  if [ "$remote_ref" = refs/heads/main ] && [[ ! "$base_sha" =~ ^0+$ ]]; then
    export PREFLIGHT_BASE_SHA="$base_sha"
  fi
fi

receipt_args=(verify --head "${head_sha:-HEAD}")
if [ -n "${PREFLIGHT_BASE_SHA:-}" ]; then
  receipt_args+=(--base "$PREFLIGHT_BASE_SHA")
fi
if [ -n "${1:-}" ]; then
  receipt_args+=(--remote-name "$1")
fi

if ! receipt_output="$($LOCAL_RECEIPT "${receipt_args[@]}" 2>&1)"; then
  receipt_reason="$(sed -n 's/^reason=//p' <<<"$receipt_output" | tail -n 1)"
  if [[ ! "$receipt_reason" =~ ^[a-z0-9-]+$ ]]; then
    receipt_reason=checker-failed
  fi
  printf 'pre-push: no valid receipt (%s). Run exactly: scripts/dev/preflight.sh --for-push --emit-receipt\n' \
    "$receipt_reason" >&2
  exit 1
fi

printf 'pre-push: exact-tree local receipt accepted for %s\n' "${head_sha:-HEAD}"
